# Service: moontracer
# Discord variables
API_SECRET_KEY=""
DISCORD_BOT_TOKEN=""
DISCORD_PUBLIC_KEY=""

# Debug variables
# If true, set the guild ID on which to test. Else, it will register all commands globally in Safe Mode.
VERBOSE=true
SAFE_MODE=true
# DEV_MODE exposes debug-only UI surfaces (Diagnostics panel on /admin,
# the /campaigndatabase slash command, future internal-tooling buttons).
# Set to false in production to hide these from end users.
DEV_MODE=true
DISCORD_GUILD_ID=""
DEBUG_ADMIN_ID=""

# Config
# Paths and global variables
ADMIN_ROLE_NAME=""
MOD_ROLE_NAME=""
