# Copy to .env and fill in real values. Never commit .env.

DISCORD_BOT_TOKEN=""

VERBOSE=false
# SAFE_MODE blocks Discord side effects (role grants, DMs) while the DB still runs.
SAFE_MODE=true
# DEV_MODE exposes debug surfaces (Diagnostics panel, /campaigndatabase). MUST be false in prod.
DEV_MODE=false

# When set, slash commands register only to this guild (fast dev iteration).
# Leave empty in production to register globally.
DISCORD_GUILD_ID=""
DEBUG_ADMIN_ID=""

MEDIA_BASE_URL=""
MEDIA_PORT=""

ADMIN_ROLE_NAME=""
MOD_ROLE_NAME=""

# Host path mounted at /app/data (SQLite DB + uploaded media).
MOONTRACER_DATA_DIR="./data"

# Docker network the container joins. Leave empty to let compose create an
# isolated network. To attach to an existing reverse-proxy network, set
# MOONTRACER_PROXY_NETWORK to that network's name AND MOONTRACER_PROXY_EXTERNAL=true.
MOONTRACER_PROXY_NETWORK=""
MOONTRACER_PROXY_EXTERNAL=""
